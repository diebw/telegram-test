# Скопіюйте цей файл у .env і заповніть значення. Файл .env у репозиторій не потрапляє.

# Токен Telegram-бота від @BotFather
BOT_TOKEN=

# ID групи менеджерів (з темами) і каналу-архіву закритих тікетів
MANAGER_GROUP_ID=
ARCHIVE_CHANNEL_ID=

# Необов'язково: розпізнавання фото через Claude (платно). Без ключа працює безкоштовний OCR
# ANTHROPIC_API_KEY=

# Необов'язково: адреса MCP-сервера T+ (за замовчуванням https://dev.tplus.market/api/mcp)
# TPLUS_MCP_URL=
